<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="farm_world">

    <!-- Physics -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Simulation systems -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Lighting -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground -->
    <model name="farm_ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.35 0.25 0.12 1</ambient>
            <diffuse>0.35 0.25 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <plugin filename="gz-sim-sensors-system"
        name="gz::sim::systems::Sensors">
     <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    
    <!-- Farm perimeter walls: 10m x 10m -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 5 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>10 0.2 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>10 0.2 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.2 1</ambient>
            <diffuse>0.2 0.5 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <pose>0 -5 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>10 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 1.0</size></box></geometry>
          <material>
            <ambient>0.2 0.5 0.2 1</ambient>
            <diffuse>0.2 0.5 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>5 0 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>0.2 10 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10 1.0</size></box></geometry>
          <material>
            <ambient>0.2 0.5 0.2 1</ambient>
            <diffuse>0.2 0.5 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-5 0 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>0.2 10 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10 1.0</size></box></geometry>
          <material>
            <ambient>0.2 0.5 0.2 1</ambient>
            <diffuse>0.2 0.5 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    
    <!-- Farm obstacles -->
    <model name="rock_1">
      <static>true</static>
      <pose>-3 3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rock_2">
      <static>true</static>
      <pose>3 3 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.7 0.7 0.7</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.7 0.7 0.7</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.32 0.22 1</ambient>
            <diffuse>0.4 0.32 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="barrier_1">
      <static>true</static>
      <pose>-3 -2 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.2 0.3 0.6</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.2 0.3 0.6</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.55 0.1 1</ambient>
            <diffuse>0.8 0.55 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    
    <!-- Crop row 1 -->
    <model name="crop_row_1">
      <static>true</static>
      <pose>-2 0 0.25 0 0 0</pose>
      <link name="crop_link">
        <collision name="collision">
          <geometry><box><size>0.3 5.0 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 5.0 0.5</size></box></geometry>
          <material>
            <ambient>0.1 0.55 0.1 1</ambient>
            <diffuse>0.1 0.55 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Crop row 2 -->
    <model name="crop_row_2">
      <static>true</static>
      <pose>0 0 0.25 0 0 0</pose>
      <link name="crop_link">
        <collision name="collision">
          <geometry><box><size>0.3 5.0 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 5.0 0.5</size></box></geometry>
          <material>
            <ambient>0.1 0.55 0.1 1</ambient>
            <diffuse>0.1 0.55 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Crop row 3 -->
    <model name="crop_row_3">
      <static>true</static>
      <pose>2 0 0.25 0 0 0</pose>
      <link name="crop_link">
        <collision name="collision">
          <geometry><box><size>0.3 5.0 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 5.0 0.5</size></box></geometry>
          <material>
            <ambient>0.1 0.55 0.1 1</ambient>
            <diffuse>0.1 0.55 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>




  </world>
</sdf>
