<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="obstacle_world">

    <!-- Physics -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Simulation systems -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Lighting -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground (sandy/dirt floor) -->
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>50 50</size></plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>50 50</size></plane>
          </geometry>
          <material>
            <ambient>0.35 0.25 0.12 1</ambient>
            <diffuse>0.35 0.25 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Perimeter walls 10 m x 10 m -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 5 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision"><geometry><box><size>10 0.2 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 1.0</size></box></geometry>
          <material><ambient>0.2 0.5 0.2 1</ambient><diffuse>0.2 0.5 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <pose>0 -5 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision"><geometry><box><size>10 0.2 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 1.0</size></box></geometry>
          <material><ambient>0.2 0.5 0.2 1</ambient><diffuse>0.2 0.5 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>5 0 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision"><geometry><box><size>0.2 10 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 10 1.0</size></box></geometry>
          <material><ambient>0.2 0.5 0.2 1</ambient><diffuse>0.2 0.5 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-5 0 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision"><geometry><box><size>0.2 10 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 10 1.0</size></box></geometry>
          <material><ambient>0.2 0.5 0.2 1</ambient><diffuse>0.2 0.5 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--
      ── FUEL MODELS ──────────────────────────────────────────────────────────
      Downloaded automatically on first launch (requires internet).
      Cached in ~/.gz/fuel/ after first use.

      Construction Barrel  = orange ribbed metal drum  (~0.9 m tall)
      Jersey Barrier       = concrete highway barrier  (~0.9 m tall)
      Construction Cone    = orange traffic cone       (~0.4 m tall)
    -->

    <!-- Barrels -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Barrel</uri>
      <name>barrel_1</name>
      <pose>3 -0.5 0 0 0 0</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Barrel</uri>
      <name>barrel_2</name>
      <pose>-3 -2 0 0 0 0.8</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Barrel</uri>
      <name>barrel_3</name>
      <pose>1 1 0 0 0 0</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Barrel</uri>
      <name>barrel_4</name>
      <pose>-2 -3.5 0 0 0 1.2</pose>
    </include>

    <!-- Jersey Barriers -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <name>barrier_1</name>
      <pose>-0.5 0.5 0 0 0 0</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <name>barrier_2</name>
      <pose>2.5 -2.5 0 0 0 1.5708</pose>
    </include>

    <!-- Construction Cones (replacing plain fence posts) -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <name>cone_1</name>
      <pose>-1.5 1 0 0 0 0</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <name>cone_2</name>
      <pose>2 -3 0 0 0 0</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <name>cone_3</name>
      <pose>-3.5 -0.5 0 0 0 0</pose>
    </include>

    <!-- Extra cones to fill out the course -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <name>cone_4</name>
      <pose>0.5 -2.5 0 0 0 0</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <name>cone_5</name>
      <pose>3.5 2 0 0 0 0</pose>
    </include>

    <!-- ── Wooden crates (custom boxes — believable wood tones) ──────────── -->
    <model name="crate_1">
      <static>true</static>
      <pose>-2 2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material>
            <ambient>0.52 0.38 0.22 1</ambient>
            <diffuse>0.55 0.40 0.22 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="crate_2">
      <static>true</static>
      <pose>2.5 1.5 0.25 0 0 0.4</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material>
            <ambient>0.45 0.32 0.18 1</ambient>
            <diffuse>0.48 0.34 0.18 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="crate_3">
      <static>true</static>
      <pose>-0.5 -1.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.6</size></box></geometry>
          <material>
            <ambient>0.50 0.36 0.20 1</ambient>
            <diffuse>0.52 0.38 0.20 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="crate_4">
      <static>true</static>
      <pose>1 3 0.25 0 0 0.8</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material>
            <ambient>0.42 0.30 0.16 1</ambient>
            <diffuse>0.44 0.32 0.16 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Soil / dirt piles ─────────────────────────────────────────────── -->
    <model name="pile_1">
      <static>true</static>
      <pose>-3.5 3 0.12 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.9 0.9 0.24</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.9 0.9 0.24</size></box></geometry>
          <material>
            <ambient>0.28 0.18 0.08 1</ambient>
            <diffuse>0.30 0.20 0.10 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="pile_1_top">
      <static>true</static>
      <pose>-3.5 3 0.28 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.65 0.65 0.12</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.65 0.65 0.12</size></box></geometry>
          <material>
            <ambient>0.24 0.15 0.06 1</ambient>
            <diffuse>0.26 0.17 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="pile_2">
      <static>true</static>
      <pose>3.5 3.5 0.10 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.7 0.7 0.20</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.7 0.7 0.20</size></box></geometry>
          <material>
            <ambient>0.28 0.18 0.08 1</ambient>
            <diffuse>0.30 0.20 0.10 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="pile_2_top">
      <static>true</static>
      <pose>3.5 3.5 0.23 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.50 0.50 0.08</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.50 0.50 0.08</size></box></geometry>
          <material>
            <ambient>0.24 0.15 0.06 1</ambient>
            <diffuse>0.26 0.17 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
