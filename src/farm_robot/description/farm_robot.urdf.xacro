<?xml version="1.0"?>
<robot name="farm_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Robot dimensions (physics unchanged) -->
  <xacro:property name="body_length"  value="0.40"/>
  <xacro:property name="body_width"   value="0.30"/>
  <xacro:property name="body_height"  value="0.10"/>
  <xacro:property name="wheel_radius" value="0.07"/>
  <xacro:property name="wheel_width"  value="0.04"/>

  <!-- ═══════════════════════════════════════════
       MAIN CHASSIS  (base_link)
       ═══════════════════════════════════════════ -->
  <link name="base_link">

    <!-- Lower hull plate  dark gray -->
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.40 0.30 0.06"/></geometry>
      <material name="dark_gray"><color rgba="0.18 0.18 0.18 1.0"/></material>
    </visual>

    <!-- Upper body / payload deck  orange -->
    <visual>
      <origin xyz="0.02 0 0.135" rpy="0 0 0"/>
      <geometry><box size="0.28 0.22 0.05"/></geometry>
      <material name="orange"><color rgba="0.91 0.42 0.00 1.0"/></material>
    </visual>

    <!-- Front bumper bar -->
    <visual>
      <origin xyz="0.21 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.02 0.34 0.06"/></geometry>
      <material name="bumper_gray"><color rgba="0.18 0.18 0.18 1.0"/></material>
    </visual>

    <!-- Rear bumper bar -->
    <visual>
      <origin xyz="-0.21 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.02 0.34 0.06"/></geometry>
      <material name="bumper_gray2"><color rgba="0.18 0.18 0.18 1.0"/></material>
    </visual>

    <!-- Left side rail  silver -->
    <visual>
      <origin xyz="0 0.155 0.10" rpy="0 0 0"/>
      <geometry><box size="0.36 0.01 0.02"/></geometry>
      <material name="silver_l"><color rgba="0.72 0.72 0.72 1.0"/></material>
    </visual>

    <!-- Right side rail  silver -->
    <visual>
      <origin xyz="0 -0.155 0.10" rpy="0 0 0"/>
      <geometry><box size="0.36 0.01 0.02"/></geometry>
      <material name="silver_r"><color rgba="0.72 0.72 0.72 1.0"/></material>
    </visual>

    <!-- Collision (unchanged) -->
    <collision>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>

    <!-- Inertial (unchanged) -->
    <inertial>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.08" ixy="0" ixz="0"
               iyy="0.12" iyz="0" izz="0.15"/>
    </inertial>
  </link>

  <!-- ═══════════════════════════════════════════
       WHEELS  (positions/physics unchanged)
       ═══════════════════════════════════════════ -->
  <xacro:macro name="wheel" params="name x y">
    <link name="${name}">

      <!-- Tyre  black -->
      <visual>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="0.040"/></geometry>
        <material name="${name}_tyre"><color rgba="0.05 0.05 0.05 1.0"/></material>
      </visual>

      <!-- Hub disc  silver -->
      <visual>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry><cylinder radius="0.038" length="0.045"/></geometry>
        <material name="${name}_hub"><color rgba="0.72 0.72 0.72 1.0"/></material>
      </visual>

      <!-- Hub centre bolt  orange -->
      <visual>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry><cylinder radius="0.010" length="0.052"/></geometry>
        <material name="${name}_bolt"><color rgba="0.91 0.42 0.00 1.0"/></material>
      </visual>

      <!-- Collision (unchanged) -->
      <collision>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>

      <!-- Inertial (unchanged) -->
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.002" ixy="0" ixz="0"
                 iyy="0.002" iyz="0" izz="0.002"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Four wheels (positions unchanged) -->
  <xacro:wheel name="front_left_wheel"  x="0.13"  y="0.17"/>
  <xacro:wheel name="front_right_wheel" x="0.13"  y="-0.17"/>
  <xacro:wheel name="rear_left_wheel"   x="-0.13" y="0.17"/>
  <xacro:wheel name="rear_right_wheel"  x="-0.13" y="-0.17"/>

  <!-- ═══════════════════════════════════════════
       GAZEBO DIFF-DRIVE PLUGIN  (unchanged)
       ═══════════════════════════════════════════ -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.34</wheel_separation>
      <wheel_radius>0.07</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </gazebo>

  <!-- ═══════════════════════════════════════════
       FRONT CAMERA MOUNT  (visual only)
       ═══════════════════════════════════════════ -->
  <link name="camera_link">
    <!-- Camera body -->
    <visual>
      <geometry><box size="0.030 0.090 0.030"/></geometry>
      <material name="cam_body"><color rgba="0.18 0.18 0.18 1.0"/></material>
    </visual>
    <!-- Lens ring -->
    <visual>
      <origin xyz="0.016 0 0" rpy="0 1.5707963 0"/>
      <geometry><cylinder radius="0.011" length="0.008"/></geometry>
      <material name="cam_lens"><color rgba="0.05 0.05 0.05 1.0"/></material>
    </visual>
    <collision><geometry><box size="0.030 0.090 0.030"/></geometry></collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
               iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.215 0 0.155" rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════════
       LIDAR MOUNT POLE  (visual only)
       ═══════════════════════════════════════════ -->
  <link name="lidar_pole_link">
    <visual>
      <geometry><cylinder radius="0.012" length="0.08"/></geometry>
      <material name="pole_gray"><color rgba="0.18 0.18 0.18 1.0"/></material>
    </visual>
    <collision><geometry><cylinder radius="0.012" length="0.08"/></geometry></collision>
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
               iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="lidar_pole_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_pole_link"/>
    <origin xyz="0.02 0 0.18" rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════════
       LIDAR SENSOR  (position unchanged: 0 0 0.22)
       ═══════════════════════════════════════════ -->
  <link name="lidar_link">
    <!-- Sensor body  blue -->
    <visual>
      <geometry><cylinder radius="0.048" length="0.050"/></geometry>
      <material name="lidar_blue"><color rgba="0.10 0.45 0.80 1.0"/></material>
    </visual>
    <!-- Top cap  dark gray -->
    <visual>
      <origin xyz="0 0 0.030" rpy="0 0 0"/>
      <geometry><cylinder radius="0.030" length="0.010"/></geometry>
      <material name="lidar_cap"><color rgba="0.18 0.18 0.18 1.0"/></material>
    </visual>

    <collision>
      <geometry><cylinder radius="0.04" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.22" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo LiDAR sensor (unchanged) -->
  <gazebo reference="lidar_link">
    <sensor name="farm_lidar" type="lidar">
      <topic>/scan</topic>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

</robot>
