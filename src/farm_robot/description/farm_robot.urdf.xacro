```xml
<?xml version="1.0"?>
<robot name="farm_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Robot dimensions -->
  <xacro:property name="body_length" value="0.40"/>
  <xacro:property name="body_width" value="0.30"/>
  <xacro:property name="body_height" value="0.10"/>
  <xacro:property name="wheel_radius" value="0.07"/>
  <xacro:property name="wheel_width" value="0.04"/>

  <!-- Main chassis -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="green">
        <color rgba="0.15 0.55 0.20 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.08" ixy="0" ixz="0"
               iyy="0.12" iyz="0" izz="0.15"/>
    </inertial>
  </link>

  <!-- Wheel macro -->
  <xacro:macro name="wheel" params="name x y">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black">
          <color rgba="0.08 0.08 0.08 1.0"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.002" ixy="0" ixz="0"
                 iyy="0.002" iyz="0" izz="0.002"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Four wheels -->
  <xacro:wheel name="front_left_wheel"  x="0.13"  y="0.17"/>
  <xacro:wheel name="front_right_wheel" x="0.13"  y="-0.17"/>
  <xacro:wheel name="rear_left_wheel"   x="-0.13" y="0.17"/>
  <xacro:wheel name="rear_right_wheel"  x="-0.13" y="-0.17"/>

</robot>
```